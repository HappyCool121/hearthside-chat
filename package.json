{
  "name": "hearthside-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node --test tests/browser.test.mjs",
    "build": "npm run typecheck && vite build",
    "build:functions": "wrangler pages functions build functions --outdir output/functions",
    "preview": "wrangler pages dev dist",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "playwright": "1.61.1",
    "tsx": "4.22.4",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "wrangler": "4.151.1"
  }
}
